node_modules/
*.log

# origin_cache/static (20MB) IS tracked: it is the theme's RequireJS modules,
# and they have to come off local disk. Served over the CDN redirect instead,
# each file took 2-3s, and RequireJS abandons a module after waitSeconds (7),
# so ~30 modules were left hanging in production and PageBuilder never ran —
# which is why the jarallax background videos rendered as empty boxes.
# origin_cache/media is 1GB and stays on B2.
site_mirror/origin_cache/media/

# Dead caches from the removed live proxies. Nothing reads these now.
site_mirror/search_cache/
site_mirror/listing_cache/

.env
.DS_Store

# Claude Code session/memory state — not app code
.claude/

# Dead leftovers from early scaffolding — server.js only reads from
# site_mirror/ (see SITE_DIR/PAGES_DIR/ASSETS_DIR in server.js). Unused.
/css/
/js/
/frontend/
/pages/
/index.html

# Stale DB backup, not the live DB
reginox.db.bak-*
backend/reginox.db

# Heavy static assets (1.5GB) — hosted on Backblaze B2 instead of git so the
# repo stays deployable on free hosts. Kept locally for dev; server.js falls
# back to a B2 signed-URL redirect when these are missing (production).
site_mirror/assets/images/
site_mirror/assets/dxf/
site_mirror/assets/video/
cf-worker/.wrangler/
